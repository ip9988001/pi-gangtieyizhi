[Unit]
Description=WeCom AiBot <-> pi bridge (钢铁意志 pi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/pi-work/wxbot
Environment="WX_BOTID=aibp_1IoLQ1JwD-ed0sMEhR7AAgNbTykp9A"
Environment="WX_SECRET=vGydmdt3cE5rycCFgHMQKyAWsxwNHmKAP6vDjJBbvMG"
ExecStart=/usr/local/bin/node /root/pi-work/wxbot/wxbot-bridge.mjs
StandardOutput=append:/root/pi-work/wxbot/bridge.log
StandardError=append:/root/pi-work/wxbot/bridge.log
Restart=always
RestartSec=5
MemoryHigh=512M
MemoryMax=768M

[Install]
WantedBy=multi-user.target
